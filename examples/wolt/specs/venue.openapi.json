        "description": "Update venue's opening times.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Not authorized to access this venue"
          },
          "500": {
            "description": "An internal error occurred"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "name": "venueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "602fb85a64983ea30328f131"
            },
            "description": "Unique identifier for the venue."
          }
        ],
        "requestBody": {
          "required": true,
