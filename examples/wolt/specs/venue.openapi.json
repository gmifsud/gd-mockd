    "/venues/{venueId}/special-opening-times": {
      "put": {
        "operationId": "update-venue-special-opening-times",
        "summary": "Set Venue Special opening times",
        "description": "Sets the venue’s Special Opening times; These date-defined periods are overrides to your weekly schedule of opening hours. These allow to set opening and closing times in advance for specific events without changing the recurring schedule of your venue. For dates not specified in a request - regular opening hours will be used. Important to note:\n\n- Each request must include the full list of future special opening and closing times. Any times not included in the new request will be removed, and the provided times will replace the previous ones.\n- Dates can appear either in “days_closed” or “days_open” - not in both.\n- Each “daily_availability” must have at least one entry (a pair of “open_time” and “close_time”); to apply more than one opening timeframe per specific entry of dates (or one date) - add each availability period as a pair of “open_time” and “close_time” within the “daily_availability” array. Those entries can’t overlap.\n\nTimes are interpreted in the **venue’s local time zone**.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request — validation failed (e.g., overlaps or bad formats)."
          },
          "403": {
            "description": "Not authorized to access this venue"
          },
          "500": {
            "description": "An internal error occurred"
          },
          "503": {
            "description": "Service unavailable — upstream error"
          }
        },
        "parameters": [
          {
            "name": "venueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "602fb85a64983ea30328f131"
            },
            "description": "Unique identifier for the venue."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Defines special opening times for a venue.\nEach item in `days_closed` or `days_open` is a **range** that generates a special-times period.\n**No calendar day** may appear in more than one range, and a day cannot be both closed and open.\n",
                "properties": {
                  "days_closed": {
                    "type": "array",
                    "description": "Fully-closed periods (00:00–24:00 for each day in the range).",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start_date": {
                          "type": "string",
                          "format": "date",
                          "description": "Start date (inclusive) in venue’s local time-zone.",
                          "example": "2025-09-09"
                        },
                        "end_date": {
                          "type": "string",
                          "format": "date",
                          "description": "End date (inclusive) in venue’s local time-zone.",
                          "example": "2025-09-11"
                        },
                        "message": {
                          "type": "string",
                          "description": "Optional note.",
                          "example": "Maintenance window"
                        }
                      },
                      "required": [
                        "start_date",
                        "end_date"
                      ],
                      "title": "ClosedRange"
                    }
                  },
                  "days_open": {
                    "type": "array",
                    "description": "Open periods with per-day windows; provide the full daily schedule in `daily_availability`.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start_date": {
                          "type": "string",
                          "format": "date",
                          "description": "Start date (inclusive) in venue’s local time-zone.",
                          "example": "2025-09-07"
                        },
                        "end_date": {
                          "type": "string",
                          "format": "date",
                          "description": "End date (inclusive) in venue’s local time-zone.",
                          "example": "2025-09-08"
                        },
                        "message": {
                          "type": "string",
                          "description": "Optional note.",
                          "example": "Lunch only"
                        },
                        "daily_availability": {
                          "type": "array",
                          "description": "**Full** per-day schedule as non-overlapping windows.\n- `open_time` must be **<** `close_time`\n- `open_time` **cannot** be `24:00`\n- `close_time` **may** be `24:00`\n",
                          "items": {
                            "type": "object",
                            "properties": {
                              "open_time": {
                                "type": "string",
                                "description": "Start time (24h, `HH:mm`). Must be < `close_time`. Cannot be `24:00`.",
                                "example": "11:30"
                              },
                              "close_time": {
                                "type": "string",
                                "description": "End time (24h, `HH:mm`). May be `24:00` to indicate end-of-day.",
                                "example": "16:00"
                              }
                            },
                            "required": [
                              "open_time",
                              "close_time"
                            ],
                            "title": "AvailabilityWindow"
                          }
                        }
                      },
                      "required": [
                        "start_date",
                        "end_date",
                        "daily_availability"
                      ],
                      "title": "OpenRange"
                    }
                  }
                },
                "title": "SpecialTimesPayload"
              }
            }
          },
          "description": "Special opening times payload."
        }
      }
    },
