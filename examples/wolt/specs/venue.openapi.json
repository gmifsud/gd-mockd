                        "opening_time": {
                          "description": "Opening time on the specified day.",
                          "type": "string",
                          "example": "10:30"
                        },
                        "closing_day": {
                          "description": "Day of the week when the venue is closed.",
                          "type": "string",
                          "enum": [
                            "MONDAY",
                            "TUESDAY",
                            "WEDNESDAY",
                            "THURSDAY",
                            "FRIDAY",
                            "SATURDAY",
                            "SUNDAY"
                          ],
                          "example": "TUESDAY"
                        },
                        "closing_time": {
                          "description": "Closing time on the specified day.",
                          "type": "string",
                          "example": "17:30"
                        }
                      },
                      "title": "WeeklyOpeningTimes"
                    }
                  }
                },
                "title": "OpeningTimesRequestPayload"
              }
            }
          },
          "description": "Update venue opening times payload."
        }
      }
    },
