  "paths": {
    "/venues/{venueId}/delivery-provider": {
      "get": {
        "operationId": "get-venue-delivery-provider",
        "summary": "Retrieve current delivery provider",
        "description": "Returns the currently defined delivery provider for a venue on the Wolt marketplace.\n\nThe returned value can be one of the following:\n\n- `WOLT` - venue delivers orders using Wolt's courier fleet.\n- `SELF_DELIVERY` - venue delivers orders using its own couriers.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "delivery_provider": {
                      "description": "The current active delivery provider for this venue.",
                      "type": "string",
                      "enum": [
                        "WOLT",
                        "SELF_DELIVERY"
                      ]
                    }
                  },
                  "title": "GetActiveDeliveryProviderResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not authorized to access this venue"
          },
          "404": {
            "description": "Venue not found"
          },
          "500": {
            "description": "An internal error occurred"
          }
        },
        "parameters": [
          {
            "name": "venueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "602fb85a64983ea30328f131"
            },
            "description": "Unique identifier for the venue."
          }
        ]
      },
      "patch": {
        "operationId": "update-venue-delivery-provider",
        "summary": "Change delivery provider",
        "description": "Changes the currently defined delivery provider for a venue on the Wolt marketplace.\n\nCan be performed successfully only if the venue has hybrid delivery functionality enabled.\n\n_Important to note - any existing purchases will not be impacted by this change. The delivery provider for a purchase is set and finalized when an order is created by the user._\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Could not change delivery provider due to validation failure."
          },
          "403": {
            "description": "Not authorized to access this venue"
          },
          "500": {
            "description": "An internal error occurred"
          }
        },
        "parameters": [
          {
            "name": "venueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "602fb85a64983ea30328f131"
            },
            "description": "Unique identifier for the venue."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Change delivery provider request payload.",
                "type": "object",
                "properties": {
                  "delivery_provider": {
                    "description": "New delivery provider that should be used by the venue",
                    "type": "string",
                    "enum": [
                      "WOLT",
                      "SELF_DELIVERY"
                    ]
                  }
                },
                "required": [
                  "delivery_provider"
                ],
                "title": "ChangeDeliveryProviderRequestPayload"
              }
            }
          },
          "description": "Change delivery provider request payload."
        }
      }
    },
    "/venues/{venueId}/online": {
      "patch": {
        "operationId": "update-venue-online-status",
        "summary": "Update venue online status",
        "description": "Update venue's online status\n\nTo schedule the venue to be offline until a certain time, set `status=OFFLINE` and `until` to the desired date and time. Otherwise, the venue will be put offline indefinitely.\n\nScheduling for online status is not supported yet.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Not authorized to access this venue"
          },
          "500": {
            "description": "An internal error occurred"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "name": "venueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "602fb85a64983ea30328f131"
            },
            "description": "Unique identifier for the venue."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "description": "The new store status to use.",
                    "type": "string",
                    "enum": [
                      "ONLINE",
                      "OFFLINE"
                    ],
                    "example": "OFFLINE"
                  },
                  "until": {
                    "description": "The date and time (ISO 8601 format) when the venue is to be set offline.\n\nUse `null` or omit the field completely to set venue offline indefinitely.\n",
                    "type": "string",
                    "nullable": true,
                    "format": "date-time"
                  }
                },
                "required": [
                  "status"
                ],
                "title": "VenueOnlineStatusRequestPayload"
              }
            }
          },
          "description": "Update venue online status payload."
        }
      }
    },
    "/venues/{venueId}/opening-times": {
      "patch": {
        "operationId": "update-venue-opening-times",
